# Copy to .env for local runs (never commit .env). In GitHub, set these as Actions secrets.

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional fallback LLM (free tier at https://console.groq.com)
GROQ_API_KEY=

# --- Instagram (publish target) ---
# Instagram professional (Creator/Business) account id, and a long-lived token from your Meta app
IG_USER_ID=
IG_ACCESS_TOKEN=
# Shown at the bottom of each image card
IG_HANDLE=@your_page
# Facebook Login path = graph.facebook.com (recommended). Instagram Login path = graph.instagram.com
IG_API_HOST=graph.facebook.com
# Bump to Meta's current Graph API version if requests are rejected as outdated
IG_API_VERSION=v24.0
# Instagram downloads the card image from a public URL. In GitHub Actions this is derived
# automatically from the (public) repo. Locally, set IMAGE_BASE_URL or GITHUB_REPOSITORY.
# IMAGE_BASE_URL=
# GITHUB_REPOSITORY=your-username/telugu-trend-agent

# --- Telegram: private approval inbox (optional channel mirror) ---
# Create a bot with @BotFather, then:
TELEGRAM_BOT_TOKEN=
# Your own chat id (message @userinfobot to get it); drafts + approve/reject buttons go here
TELEGRAM_OWNER_CHAT_ID=
# Optional: also mirror published cards to a public Telegram channel
TELEGRAM_CHANNEL_ID=

# --- Life-hacks mode (English carousels, written only from content/hacks.json) ---
# Leave the IG_HACKS_* values empty to post hacks to the same Instagram account as above.
# To use a separate account, put its own id and token here (create it the same way, see README).
IG_HACKS_USER_ID=
IG_HACKS_ACCESS_TOKEN=
IG_HACKS_HANDLE=
# Carousels per day (0 turns the mode off)
HACKS_PER_DAY=1

# Telugu Locals heritage posts per day (0 turns that mode off)
POSTS_PER_DAY=3
# true = skip approval and publish straight to Instagram (not recommended at first)
AUTO_PUBLISH=false
