# Copy to .env for local runs (never commit .env). In GitHub, set these as Actions secrets.

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional fallback LLM (free tier at https://console.groq.com)
GROQ_API_KEY=

# Telegram: create a bot with @BotFather, then:
TELEGRAM_BOT_TOKEN=
# Your own chat id (message @userinfobot to get it) - drafts + approve/reject buttons go here
TELEGRAM_OWNER_CHAT_ID=
# Public channel to publish to, e.g. @my_telugu_channel (add the bot as channel admin)
TELEGRAM_CHANNEL_ID=

POSTS_PER_DAY=3
# true = skip approval and publish straight to the channel (not recommended at first)
AUTO_PUBLISH=false
